// Welcome to Nulo!

// This program demonstrates some of the core features of the language.

// File inclusion
@hello.nulo // includes the contents of hello.nulo file, the whole thing
@bye.nulo import fairwell(), formality   // includes the function fairwell and Variable formality

// Variable declaration and assignment
name = "World";

// Using the built-in print() function with string interpolation
print("Hello, ${name}!");

// Defining a function
def greet(person) {
    print("Greetings, ${person}!");
}

// Calling the function
greet("Nulo Programmer");

// Working with a list
names = ["Alice", "Bob", "Charlie"]; // Lists are basically a dynamic array
print("Printing names from a list:");

// Using a for-each loop to iterate over the list
for (name in names) {
    print("- ${name}");
}

// Using conditional logic
x = 10;
if (x > 5) {
    print("x (${x}) is greater than 5.");
} else {
    print("x (${x}) is not greater than 5.");
}

// Getting user input
username = input("What's your name?");
print("Nice to meet you, ${username}!");

/*
    Can also be used as comment
*/

print ("""
    Is a multi line string
""");
// also can be """ """ or ''' '''